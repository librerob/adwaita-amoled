$variant: 'dark';
$contrast: 'normal';
@import '46/upstream/colors';
@import 'amoled';
$selected_bg_color: {{accent_fill}};
$selected_fg_color: {{foreground}};
$selected_borders_color: {{accent_text}};
$link_color: {{accent_text}};
$link_visited_color: {{accent_text_hover}};
$focus_color: {{accent_text}};
$focus_border_color: transparentize($focus_color, 0.5);
@import '46/upstream/drawing';
@import '46/upstream/common';
@import '46/upstream/widgets';
@import 'readability-46';
