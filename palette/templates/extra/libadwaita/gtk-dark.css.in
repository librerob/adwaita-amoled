@import url('libadwaita-tweaks.css');

/* ── Accent ──────────────────────────────────────────────────────────────── */
@define-color accent_color             {{accent_text}};
@define-color accent_bg_color          {{accent_fill}};
@define-color accent_fg_color          {{foreground}};

/* ── Window / base ───────────────────────────────────────────────────────── */
@define-color window_bg_color          {{background}};
@define-color window_fg_color          {{foreground}};

/* ── View (lists, treeviews, text areas) ─────────────────────────────────── */
@define-color view_bg_color            {{surface}};
@define-color view_fg_color            {{foreground}};

/* ── Headerbar ───────────────────────────────────────────────────────────── */
@define-color headerbar_bg_color       #0e0e0e;
@define-color headerbar_fg_color       {{foreground}};
@define-color headerbar_border_color   {{decorative_border}};
@define-color control_border_color     {{control_border}};
@define-color headerbar_backdrop_color {{background}};
@define-color headerbar_shade_color    rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.5);
@define-color headerbar_darker_shade_color rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.9);

/* ── Cards ───────────────────────────────────────────────────────────────── */
@define-color card_bg_color            {{surface}};
@define-color card_fg_color            {{foreground}};
@define-color card_shade_color         rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.4);

/* ── Dialog ──────────────────────────────────────────────────────────────── */
@define-color dialog_bg_color          {{popover}};
@define-color dialog_fg_color          {{foreground}};

/* ── Popover / tooltip ───────────────────────────────────────────────────── */
@define-color popover_bg_color         {{popover}};
@define-color popover_fg_color         {{foreground}};
@define-color popover_shade_color      rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.4);

/* ── Thumbnail ───────────────────────────────────────────────────────────── */
@define-color thumbnail_bg_color       {{popover}};
@define-color thumbnail_fg_color       {{foreground}};

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
@define-color sidebar_bg_color         {{background}};
@define-color sidebar_fg_color         {{foreground}};
@define-color sidebar_backdrop_color   {{background}};
@define-color sidebar_border_color     {{decorative_border}};
@define-color sidebar_shade_color      rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.4);

/* ── Secondary sidebar ───────────────────────────────────────────────────── */
@define-color secondary_sidebar_bg_color       #0a0a0a;
@define-color secondary_sidebar_fg_color       {{foreground}};
@define-color secondary_sidebar_backdrop_color {{background}};
@define-color secondary_sidebar_border_color   {{decorative_border}};
@define-color secondary_sidebar_shade_color    rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.4);

/* ── Shade / scrollbar ───────────────────────────────────────────────────── */
@define-color shade_color              rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.4);
@define-color scrollbar_outline_color  rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.95);

/* ── Semantic status colors ──────────────────────────────────────────────── */
@define-color destructive_color        {{error_text}};
@define-color destructive_bg_color     {{destructive_fill}};
@define-color destructive_fg_color     {{foreground}};

@define-color success_color            {{success_text}};
@define-color success_bg_color         {{success_fill}};
@define-color success_fg_color         {{background}};

@define-color warning_color            {{warning_text}};
@define-color warning_bg_color         {{warning_fill}};
@define-color warning_fg_color         rgba({{background.r}}, {{background.g}}, {{background.b}}, 0.8);

@define-color error_color              {{error_text}};
@define-color error_bg_color           {{destructive_fill}};
@define-color error_fg_color           {{foreground}};

/* ── Legacy GTK3 named color aliases (adw-gtk3 compatibility) ────────────── */
@define-color theme_bg_color           {{background}};
@define-color theme_fg_color           {{foreground}};
@define-color theme_base_color         {{surface}};
@define-color theme_text_color         {{foreground}};
@define-color theme_selected_bg_color  @accent_bg_color;
@define-color theme_selected_fg_color  {{foreground}};
@define-color insensitive_bg_color     #0a0a0a;
@define-color insensitive_fg_color     #909090;
@define-color insensitive_base_color   {{surface}};
