# ── Cursor ────────────────────────────────────────────────────────────────────
# @accent blue
cursor {{accent_text}}
# pure black behind cursor glyph
cursor_text_color {{background}}

# ── Mouse / URLs ───────────────────────────────────────────────────────────────
# link color
url_color {{syntax_cyan}}

# ── Tabs ──────────────────────────────────────────────────────────────────────
tab_bar_edge            bottom
tab_bar_style           powerline
tab_powerline_style     slanted
tab_bar_min_tabs        2
tab_bar_margin_width    0.0
tab_title_template      "{bell_symbol}{activity_symbol}{index}: {title}"
active_tab_font_style   bold
inactive_tab_font_style normal

active_tab_foreground   {{background}}
# @accent blue
active_tab_background   {{accent_text}}
# disabled/backdrop text
inactive_tab_foreground {{secondary_text}}
# surface_hover
inactive_tab_background {{hover}}
tab_bar_background      {{background}}

# ── Core palette ──────────────────────────────────────────────────────────────
background            {{background}}
foreground            {{foreground}}

# Blue-tinted selection with white text
selection_foreground  {{foreground}}
selection_background  {{accent_selection}}

# ── Normal colors ─────────────────────────────────────────────────────────────
# pure black (terminal fill)
color0  {{background}}
# error — softened from #ff0000
color1  {{error_text}}
# success
color2  {{syntax_green}}
# warning
color3  {{syntax_yellow}}
# @accent blue
color4  {{accent_text}}
# readable syntax magenta
color5  {{syntax_magenta}}
# link/cyan
color6  {{syntax_cyan}}
# primary fg
color7  {{foreground}}

# ── Bright colors (bold text) ─────────────────────────────────────────────────
# readable bright-black text
color8  {{muted_text}}
# brighter error
color9  #ff9a9a
# brighter success
color10 #4affc4
# brighter warning
color11 #ffcc44
# @accent_hover
color12 {{accent_text_hover}}
# brighter magenta
color13 #e599ff
# bright cyan
color14 #44ddff
# backdrop text
color15 #fafafa

# ── Faint/dim ANSI text ────────────────────────────────────────────────────────
# Kitty dims the normal palette through opacity, rather than a dim0–dim7 palette.
dim_opacity 0.75
